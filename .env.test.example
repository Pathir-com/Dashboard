# Pathir e2e test credentials. Copy to .env.test (gitignored) and fill in.
#
# SUPABASE_* keys are auto-bootstrapped from ~/.supabase/access-token via
# the Management API if missing — but ElevenLabs and Twilio creds are
# digest-masked there, so they MUST be supplied here.

ELEVENLABS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Optional — enables the real-SMS leg of 03-sms-twoway and 06-vapi-call
TEST_TARGET_PHONE=

# Optional — enables the VAPI call test (06-vapi-call)
VAPI_API_KEY=

# Override the platform trial sender if a dedicated trial number is provisioned
PATHIR_TRIAL_SMS_NUMBER=+447418341716
